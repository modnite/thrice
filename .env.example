# THRICE settings. Copy this file to .env and change the database password. Everything else is optional.
# Business details, accounts, addresses, payment options and website API keys are set inside the app, not here.

# --- Database ---
# Letters and numbers only in the password.
POSTGRES_USER=thrice
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=thrice

# --- Where it listens ---
# APP_PORT is the port on this machine. APP_BIND=127.0.0.1 hides it from the network (use with the proxy profile).
APP_PORT=3000
APP_BIND=0.0.0.0
NODE_ENV=production

# --- HTTPS (optional) ---
# For a public server: point a domain at this machine, put it here and start with
#   docker compose --profile proxy up -d
# Leave blank for a local or LAN install reached over plain http.
THRICE_DOMAIN=

# --- Accounts ---
# There is nothing to set here. The first visit to the site shows a setup page and creates the owner. Owner and staff
# accounts live in the database, never in this file.
# On a server the internet can reach, finish setup straight away, or make the page ask for a one-time code that is
# printed in the server log (docker compose logs migrate):
# REQUIRE_SETUP_CODE=true

# --- Email ---
# Set up in the app under Settings > Integrations. The mail password is stored encrypted in the database.
# By default the key that protects it is created for you and kept in the database. To keep the two apart,
# put a long random value here (changing it later makes saved mail passwords unreadable, and you re-enter them).
# APP_SECRET=
# Older way, still honoured when nothing is saved in the app: SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASSWORD, SMTP_FROM.

# --- Backups ---
BACKUP_KEEP_DAYS=14

# --- Advanced ---
# Force the session cookie's Secure flag on or off. By default it follows whether the request came in over https.
# COOKIE_SECURE=
# Older way to accept website API keys. Prefer creating keys in Settings > Integrations.
# PUBLIC_API_STORE_SLUG=
# PUBLIC_API_KEY_HASHES=
